# ESSI Employer Portal (frontend) – settings. Copy to frontend/.env and adjust; restart `npm run dev` after changes.
# These values are built into the JavaScript that browsers download: NEVER put passwords or API keys here.
# All credentials (database, SMTP, SMS, admin, 1LINK) go in backend/.env.

# Backend API address (including /api/v1)
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Show the "SMS / email inbox (testing)" link on the login page. Set false in production.
VITE_SHOW_TEST_INBOX=true

# Largest document the registration form accepts (MB) – same as MAX_UPLOAD_MB in backend/.env
VITE_MAX_UPLOAD_MB=5
