# SESSI Employer Portal API – settings.
# Copy this file to backend/.env and fill in the values. Never commit the real .env (it is in .gitignore).
# Restart the API after changing anything here.

# ------------------------------------------------------------------ general
# development | production   (production refuses to start with a weak JWT_SECRET or DEMO_MODE=true)
ENVIRONMENT=development

# Address of the employer portal (frontend). Used in links inside e-mails.
FRONTEND_URL=http://localhost:5173

# Frontend address(es) allowed to call the API – JSON list
CORS_ORIGINS=["http://localhost:5173"]

# true: SMS / e-mails can be read at GET /api/v1/demo/outbox and the portal's #/inbox page (testing only).
# Must be false in production.
DEMO_MODE=true

# ------------------------------------------------------------------ database
# SQLite (local development, nothing to install):
DATABASE_URL=sqlite:///./sessi.db
# PostgreSQL (server):
# DATABASE_URL=postgresql+psycopg://sessi_user:CHANGE_ME@localhost:5432/sessi

# ------------------------------------------------------------------ sign-in tokens
# Long random value. Generate one: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_VALUE
ACCESS_TOKEN_MINUTES=60

# ------------------------------------------------------------------ first ESSI admin
# When ADMIN_PASSWORD is set and there is no admin yet, the API creates this account when it starts.
# Password: at least 8 characters with a capital letter and a number.
# After the first sign-in, change the password and clear ADMIN_PASSWORD here.
# (Or leave it empty and run: python -m app.create_admin)
ADMIN_USERNAME=admin
ADMIN_NAME=ESSI Administrator
ADMIN_PASSWORD=

# ------------------------------------------------------------------ e-mail (SMTP)
# Empty SMTP_HOST = e-mails are only kept in the outbox.
# Port 587 with SMTP_USE_TLS=true (STARTTLS), or port 465 with SMTP_USE_TLS=false (SSL).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=ESSI Sindh <no-reply@sessi.gov.pk>
SMTP_USE_TLS=true

# ------------------------------------------------------------------ SMS gateway (HTTP)
# Empty SMS_API_URL = SMS are only kept in the outbox.
# The request format is in backend/app/services/delivery.py (_send_sms) – adjust it to your provider.
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=SESSI

# How often queued SMS / e-mails are sent (seconds), and how many tries before a message is marked failed
DELIVERY_INTERVAL_SECONDS=15
DELIVERY_MAX_ATTEMPTS=5

# ------------------------------------------------------------------ 1LINK / 1Bill payments (not connected yet)
# Payments are currently confirmed by the demo endpoint POST /employer/challans/{no}/pay.
ONELINK_API_URL=
ONELINK_CLIENT_ID=
ONELINK_CLIENT_SECRET=
ONELINK_BILL_PREFIX=1009801

# ------------------------------------------------------------------ uploaded documents
# Folder for registration documents (keep it outside the web root and back it up).
UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_MB=5
